# Secrets requeridos para Edge Functions (Dashboard → Edge Functions → Secrets)

CRON_SECRET=<generar-un-secreto-largo-aleatorio>
SUPABASE_ANON_KEY=<anon-key-del-proyecto>
ALLOWED_ORIGINS=https://tu-dominio.vercel.app,http://localhost:8080
RESEND_API_KEY=<tu-resend-key>
RESEND_FROM=Malda <noreply@tu-dominio.com>

# El cron local (scripts/programar-cobros-mensuales.js) debe usar:
#   Authorization: Bearer $CRON_SECRET
#   x-cron-secret: $CRON_SECRET

# Tras resetear el proyecto, aplicar también:
#   HARDENING_POST_RESET.sql
#   (o supabase/migrations/20260810_hardening_seguridad_turnos.sql)
